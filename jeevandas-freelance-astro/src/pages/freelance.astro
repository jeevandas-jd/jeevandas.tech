;margin:0;color:#4f504a}.hero-bottom p strong{color:var(--ink)}.hero-cta{background:var(--ink);color:var(--paper);padding:17px 20px;display:inline-flex;align-items:center;gap:32px;font:11px var(--mono);text-transform:uppercase;letter-spacing:.08em;transition:.2s}.hero-cta:hover{background:#45483b;transform:translateY(-3px)}.hero-cta b{font-size:18px;font-weight:400}.portrait{align-self:center;justify-self:end;width:min(100%,390px);margin:0;position:relative;padding:0 13px 16px 0}.portrait:before{content:'';position:absolute;inset:13px 0 0 13px;border:1px solid var(--ink);z-index:0}.portrait-frame{position:relative;z-index:1;aspect-ratio:1/1.08;overflow:hidden;background:#b5b7a5;border:1px solid var(--ink)}.portrait-frame img{display:block;width:100%;height:100%;object-fit:cover;object-position:center 43%;filter:saturate(.88) contrast(1.03)}.portrait-mark{position:absolute;right:10px;top:10px;background:var(--acid);color:var(--ink);padding:7px 9px;font:10px var(--mono);letter-spacing:.08em}.portrait figcaption{position:relative;z-index:1;display:flex;justify-content:space-between;gap:12px;padding:10px 0 0;font:9px var(--mono);letter-spacing:.08em;color:var(--muted)}.ticker{border-block:1px solid var(--line);overflow:hidden;padding:13px 0;white-space:nowrap}.ticker-track{display:flex;width:max-content;animation:marquee 32s linear infinite}.ticker span{font:10px var(--mono);letter-spacing:.16em;text-transform:uppercase;padding:0 25px;color:#55564f}.ticker i{font-style:normal;color:#9a9a8e}section{padding:110px 0;border-bottom:1px solid var(--line)}.section-head{display:grid;grid-template-columns:1fr 2fr;gap:30px;margin-bottom:60px}.section-head .eyebrow{padding-top:9px}.section-head h2{font-size:clamp(38px,6vw,76px);line-height:.98;letter-spacing:-.075em;font-weight:600;margin:0;max-width:850px}.section-head h2 em{font-style:normal;color:var(--muted)}.manifesto{display:grid;grid-template-columns:1fr 1fr;gap:8vw;align-items:start}.manifesto .big{font-size:clamp(24px,3.2vw,42px);line-height:1.18;letter-spacing:-.055em;margin:0;max-width:580px}.manifesto .small{font-size:15px;line-height:1.8;color:#62635c;max-width:430px;margin:5px 0 0}.manifesto .small p{margin:0 0 18px}.signature{font:11px var(--mono);letter-spacing:.08em;text-transform:uppercase;margin-top:34px;display:flex;gap:12px;align-items:center}.signature:before{content:'';width:34px;height:1px;background:var(--ink)}.service-list,.work-list,.steps{border-top:1px solid var(--line)}.service{display:grid;grid-template-columns:70px 1.1fr 1fr 180px;gap:25px;align-items:center;padding:29px 0;border-bottom:1px solid var(--line);transition:padding .25s}.service:hover{padding-inline:12px}.service .index,.work .index,.step .index{color:var(--muted)}.service h3{font-size:clamp(22px,2.7vw,34px);letter-spacing:-.06em;margin:0;font-weight:600}.service p{font-size:13px;line-height:1.7;color:#64655d;margin:0;max-width:420px}.service .tag{font-size:9px;color:#77776f;line-height:1.8;text-align:right}.work{display:grid;grid-template-columns:70px 1fr 1.2fr 44px;gap:24px;padding:35px 0;border-bottom:1px solid var(--line);align-items:start;transition:background .2s}.work:hover{background:#ffffff2b}.work .index{padding-top:9px}.work h3{font-size:clamp(32px,4vw,55px);letter-spacing:-.08em;line-height:.95;margin:0 0 13px;font-weight:600}.work .kind{font:10px var(--mono);letter-spacing:.1em;color:var(--muted)}.work .desc{font-size:14px;line-height:1.75;color:#606159;max-width:480px}.work .desc strong{display:block;color:var(--ink);font-size:11px;font-family:var(--mono);font-weight:400;letter-spacing:.06em;text-transform:uppercase;margin-top:17px}.work .arrow{font-size:25px;transition:transform .2s}.work:hover .arrow{transform:translate(4px,-4px)}.approach{display:grid;grid-template-columns:1fr 1fr;gap:8vw}.approach h2{font-size:clamp(40px,6vw,76px);line-height:.94;letter-spacing:-.08em;font-weight:600;margin:0}.step{display:grid;grid-template-columns:45px 1fr;gap:15px;padding:22px 0;border-bottom:1px solid var(--line)}.step .index{padding-top:4px}.step h3{font-size:17px;margin:0 0 6px;letter-spacing:-.04em}.step p{font-size:13px;line-height:1.7;color:#66675f;margin:0}.packages{display:grid;grid-template-columns:repeat(3,1fr);border-block:1px solid var(--line)}.package{padding:28px 25px 30px 0;border-right:1px solid var(--line);margin-right:25px;display:flex;flex-direction:column;min-height:300px}.package:last-child{border:0;margin:0}.package .meta{color:var(--muted)}.package h3{font-size:29px;letter-spacing:-.07em;margin:28px 0 10px}.package p{font-size:13px;line-height:1.7;color:#65665e;max-width:280px}.package .price{margin-top:auto;font-size:12px;font-family:var(--mono);padding-top:25px}.package .price b{font-size:20px;font-weight:500}.contact{background:var(--ink);color:var(--paper);padding:100px 0 40px}.contact .eyebrow{color:#a3a49a}.contact .eyebrow:before{background:#a3a49a}.contact-grid{display:grid;grid-template-columns:1.5fr .5fr;gap:30px;align-items:end}.contact h2{font-size:clamp(62px,10vw,130px);letter-spacing:-.105em;line-height:.84;font-weight:600;margin:35px 0 32px}.contact h2 span{color:var(--acid)}.contact-copy{font-size:14px;color:#b3b4aa;line-height:1.7;max-width:360px}.contact-link{display:inline-flex;align-items:center;gap:20px;border-bottom:1px solid #8a8b82;padding:0 0 13px;margin-top:25px;font:11px var(--mono);text-transform:uppercase;letter-spacing:.08em}.contact-link b{font-size:22px;color:var(--acid);font-weight:400}.contact-side{display:flex;flex-direction:column;gap:16px;padding-bottom:8px}.contact-side a{font:11px var(--mono);letter-spacing:.07em;text-transform:uppercase;color:#c6c7bf;border-bottom:1px solid #4c4d47;padding-bottom:12px;display:flex;justify-content:space-between}.contact-side a:hover{color:var(--acid)}.footer{border-top:1px solid #44453f;margin-top:100px;padding-top:18px;display:flex;justify-content:space-between;color:#85867d;font:10px var(--mono);letter-spacing:.08em;text-transform:uppercase}.reveal{opacity:0;transform:translateY(22px);transition:opacity .7s ease,transform .7s cubic-bezier(.2,.7,.2,1)}.reveal.visible{opacity:1;transform:none}@keyframes spin{to{transform:rotate(360deg)}}@keyframes marquee{to{transform:translateX(-50%)}}@media(max-width:800px){.wrap{width:min(100% - 36px,600px)}.nav{gap:14px}.nav a:nth-child(2),.availability{display:none}.hero{min-height:auto;padding:75px 0 60px;grid-template-columns:1fr}.hero h1{font-size:clamp(66px,17vw,112px)}.hero-bottom{align-items:start;flex-direction:column}.portrait{width:min(78%,290px);justify-self:end;margin-top:28px}.section-head{grid-template-columns:1fr;gap:20px;margin-bottom:38px}.manifesto,.approach{grid-template-columns:1fr;gap:35px}.service{grid-template-columns:35px 1fr;gap:12px;padding:22px 0}.service p,.service .tag{grid-column:2}.service .tag{text-align:left}.work{grid-template-columns:35px 1fr 28px;gap:12px;padding:27px 0}.work .desc{grid-column:2}.work .arrow{grid-column:3;grid-row:1}.packages{grid-template-columns:1fr}.package{min-height:220px;border-right:0;border-bottom:1px solid var(--line);margin:0;padding:25px 0}.package:last-child{border:0}.contact-grid{grid-template-columns:1fr}.contact-side{margin-top:35px}.footer{margin-top:65px;gap:15px;flex-wrap:wrap}section{padding:78px 0}}@media(prefers-reduced-motion:reduce){*,*:before,*:after{scroll-behavior:auto!important;animation:none!important;transition:none!important}.reveal{opacity:1;transform:none}}
</style></head><body>
<header class="wrap top"><a class="brand" href="#top">JEEVANDAS<sup>®</sup></a><nav class="nav"><a href="#services">Capabilities</a><a href="#work">Selected work</a><a href="#contact">Contact ↗</a></nav><div class="availability mono"><span class="dot"></span> Available for select projects</div></header>
<main id="top"><div class="wrap hero"><div><div class="eyebrow">Independent digital practice · Kochi / Worldwide</div><h1><span>Make it</span><span class="stroke">work.</span></h1><div class="hero-bottom"><p><strong>AI systems. Thoughtful websites. Software that earns its place.</strong><br/>I design and build digital tools for people with real work to do.</p><a class="hero-cta" href="#contact">Start a project <b>↗</b></a></div></div><figure class="portrait reveal"><div class="portrait-frame"><img src="/images/jeevandas-portrait.png" alt="Jeevandas standing outdoors, wearing glasses and a patterned shirt"/><span class="portrait-mark">J / 001</span></div><figcaption><span>JEEVANDAS M S</span><span>AI SYSTEMS · FULL-STACK</span></figcaption></figure></div><div class="ticker"><div class="ticker-track"><span>Useful by design <i>✳</i> Built with intent <i>✳</i> AI without theatre <i>✳</i> From first sketch to production <i>✳</i> Useful by design <i>✳</i> Built with intent <i>✳</i> AI without theatre <i>✳</i> From first sketch to production <i>✳</i></span></div></div>
<section class="wrap" id="about"><div class="section-head reveal"><div class="eyebrow">00 / Point of view</div><h2>Good software should feel <em>obvious</em> once it exists.</h2></div><div class="manifesto reveal"><p class="big">I’m an AI and full-stack developer who cares about the bit after the demo: when someone has to use the thing, every day.</p><div class="small"><p>I work across product thinking, interface design, backend engineering and applied AI. The aim is not to add technology for its own sake. It is to make a messy process clearer, a slow task quicker, or a business easier to trust.</p><p>Small independent practice. Direct communication. No layers between the idea and the person building it.</p><div class="signature">Jeevandas · Builder / Engineer</div></div></div></section>
<section class="wrap" id="services"><div class="section-head reveal"><div class="eyebrow">01 / What I do</div><h2>Three ways to move a good idea <em>forward.</em></h2></div><div class="service-list">{services.map(s => <article class="service reveal"><div class="index">{s.n}</div><h3>{s.title}</h3><p>{s.body}</p><div class="tag">{s.tags}</div></article>)}</div></section>
<section class="wrap" id="work"><div class="section-head reveal"><div class="eyebrow">02 / Selected experiments</div><h2>Proof of work, not a wall of <em>mockups.</em></h2></div><div class="work-list">{projects.map(p => <a class="work reveal" href="https://github.com/jeevandas-jd" target="_blank" rel="noreferrer"><div class="index">{p.id}</div><div><h3>{p.name}</h3><div class="kind">{p.kind}</div></div><div class="desc">{p.line}<br/>{p.detail}<strong>{p.result}</strong></div><div class="arrow">↗</div></a>)}</div><p class="footnote" style="color:#77776f;margin-top:18px">Selected prototypes and engineering projects. Commercial client work is not implied.</p></section>
<section class="wrap" id="process"><div class="approach"><div class="reveal"><div class="eyebrow">03 / Working method</div><h2>Less theatre.<br/>More shipped.</h2></div><div class="steps"><article class="step reveal"><div class="index">01</div><div><h3>Understand the actual problem</h3><p>A short conversation, a few sharp questions, and a clear definition of what success looks like.</p></div></article><article class="step reveal"><div class="index">02</div><div><h3>Shape the smallest useful version</h3><p>Agree on scope, timeline and a sensible build plan before writing a line of code.</p></div></article><article class="step reveal"><div class="index">03</div><div><h3>Build in the open</h3><p>Frequent previews, honest trade-offs and feedback while changes are still easy.</p></div></article><article class="step reveal"><div class="index">04</div><div><h3>Launch. Then look after it.</h3><p>Deployment, handover and ongoing improvements when the product needs them.</p></div></article></div></div></section>
<section class="wrap" id="packages"><div class="section-head reveal"><div class="eyebrow">04 / Engagements</div><h2>A clear starting point. <em>A scope that fits.</em></h2></div><div class="packages"><article class="package reveal"><div class="meta">01 / Quick launch</div><h3>One clear page.</h3><p>A focused landing page for a service, campaign or small business. Responsive, quick and easy to understand.</p><div class="price">Indicative starting point <b>₹8,000</b></div></article><article class="package reveal"><div class="meta">02 / Business presence</div><h3>A proper home online.</h3><p>Multi-page business website with enquiry flow, content structure, basic SEO and deployment.</p><div class="price">Indicative starting point <b>₹15,000</b></div></article><article class="package reveal"><div class="meta">03 / Custom build</div><h3>Built around your work.</h3><p>Web applications, dashboards and AI-assisted workflows. Scoped after understanding the problem.</p><div class="price">Quoted to scope <b>↗</b></div></article></div><p class="footnote" style="color:#77776f;margin-top:16px">Indicative prices only. Final quote depends on scope, content and integrations.</p></section></main>
<footer class="contact" id="contact"><div class="wrap"><div class="eyebrow">05 / Have a real problem?</div><div class="contact-grid"><div><h2>Let's make<br/><span>it useful.</span></h2><p class="contact-copy">Tell me what you are trying to build, fix or simplify. I’ll reply with a few questions and an honest next step.</p><a class="contact-link" href="mailto:hello@jeevandas.tech?subject=Project%20enquiry">Send a project note <b>↗</b></a></div><div class="contact-side"><a href="https://wa.me/91XXXXXXXXXX" target="_blank" rel="noreferrer">WhatsApp <span>↗</span></a><a href="mailto:hello@jeevandas.tech">Email <span>↗</span></a><a href="https://www.linkedin.com/in/YOUR-LINKEDIN/" target="_blank" rel="noreferrer">LinkedIn <span>↗</span></a><a href="https://github.com/jeevandas-jd" target="_blank" rel="noreferrer">GitHub <span>↗</span></a></div></div><div class="footer"><span>© 2026 Jeevandas®</span><span>Independent digital practice</span><a href="#top">Back to top ↑</a></div></div></footer>
<script>const observer=new IntersectionObserver(entries=>{entries.forEach(entry=>{if(entry.isIntersecting){entry.target.classList.add('visible');observer.unobserve(entry.target)}})},{threshold:.12});document.querySelectorAll('.reveal').forEach(el=>observer.observe(el));</script></body></html>
