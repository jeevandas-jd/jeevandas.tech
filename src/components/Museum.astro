---
// Museum.astro
---

<section id="museum">
  <div class="container">
    <p class="label faint hand">museum of failures</p>
    <span class="rule"></span>

    <div class="museum-wrap">
      <div class="ticket">
        <div class="ticket-left">
          <span class="ticket-label hand">ADMIT ONE</span>
          <span class="ticket-title hand">Museum of<br>Failures</span>
          <span class="ticket-sub faint">est. 2024</span>
        </div>
        <div class="ticket-divider">
          <div class="notch top"></div>
          <div class="dash-line"></div>
          <div class="notch bottom"></div>
        </div>
        <div class="ticket-right">
          <span class="ticket-status hand">coming soon</span>
          <span class="ticket-visitors faint">
            <span class="visitor-count" id="visitor-count">—</span> visitors waiting
          </span>
        </div>
      </div>

      <p class="museum-note soft">
        every project that didn't work out.<br>
        every idea that crashed.<br>
        every lesson I paid for.<br>
        documented, framed, and on display.
      </p>
    </div>
  </div>
</section>

<style>
  .label {
    font-size: 0.9rem;
    letter-spacing: 0.08em;
    margin-bottom: 0.4rem;
  }

  .museum-wrap {
    margin-top: 2.5rem;
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  /* ── ticket ──────────────────────────────────────────── */
  .ticket {
    display: flex;
    align-items: stretch;
    background: var(--paper);
    border: 1.5px solid var(--rule);
    border-radius: 4px;
    overflow: visible;
    position: relative;
    max-width: 480px;
    box-shadow: 3px 3px 0 var(--rule);
  }

  .ticket-left {
    flex: 1;
    padding: 1.5rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .ticket-label {
    font-size: 0.75rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .ticket-title {
    font-size: 1.6rem;
    line-height: 1.15;
    font-weight: 700;
  }

  .ticket-sub { font-size: 0.8rem; }

  .ticket-divider {
    width: 1px;
    background: var(--rule);
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
  }

  .dash-line {
    flex: 1;
    border-left: 2px dashed var(--rule);
    width: 0;
  }

  .notch {
    width: 20px;
    height: 20px;
    background: var(--bg);
    border-radius: 50%;
    border: 1.5px solid var(--rule);
    flex-shrink: 0;
    margin-inline: -10px;
  }

  .ticket-right {
    width: 110px;
    padding: 1.5rem 1rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    text-align: center;
  }

  .ticket-status {
    font-size: 1rem;
    font-weight: 700;
    writing-mode: vertical-rl;
    text-orientation: mixed;
    transform: rotate(180deg);
    letter-spacing: 0.1em;
  }

  .ticket-visitors {
    font-size: 0.75rem;
    line-height: 1.4;
  }

  .visitor-count {
    font-family: var(--font-hand);
    font-size: 1rem;
  }

  /* ── note ─────────────────────────────────────────────── */
  .museum-note {
    font-size: 1rem;
    line-height: 2;
  }
</style>
