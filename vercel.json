{
  "buildCommand": "bash build.sh",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/survey-form",
      "destination": "https://relai-survay-form.vercel.app"
    },
    {
      "source": "/survey-form/(.*)",
      "destination": "https://relai-survay-form.vercel.app/$1"
    },
    {
      "source": "/dev",
      "destination": "/dev/index.html"
    },
    {
      "source": "/dev/(.*)",
      "destination": "/dev/$1"
    }
  ]
}
