{
  "rewrites": [
    {
      "source": "/dev",
      "destination": "/portfolio/index.html"
    },
    {
      "source": "/dev/(.*)",
      "destination": "/portfolio/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/dist/$1"
    }
  ],
  "builds": [
    {
      "src": "portfolio/**",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "portfolio/dist",
        "buildCommand": "cd portfolio && npm run build"
      }
    },
    {
      "src": "dist/**",
      "use": "@vercel/static"
    }
  ]
}
